<Project Sdk="Microsoft.NET.Sdk">
  <!-- Port of packages/coding-agent's CLI entry points (`cli.ts` + `rpc-entry.ts`).
       AssemblyName is `pi` so `dotnet build` produces pi.exe / pi, matching the TS bin name. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pi</AssemblyName>
    <!-- 版本统一由根目录 Directory.Build.props 的 <Version> 提供（与 13 个 NuGet 包同步）。
         注意：它只决定程序集版本，而 Config.Version 优先读随包分发的
         Pi.CodingAgent/Assets/package.json（TS 语义）。两处必须同时改，
         Directory.Build.targets 的 ValidatePackagedVersion 会在不一致时直接报错。 -->
    <RootNamespace>Pi.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pi.CodingAgent\Pi.CodingAgent.csproj" />
  </ItemGroup>

  <!--
    Native AOT publishing is opt-in: `bash scripts/publish-aot.sh` (i.e.
    `dotnet publish ... -p:PublishAot=true -r <rid>`). All AOT-specific MSBuild
    settings live in Directory.Build.props / Directory.Build.targets, gated on
    PublishAot=true, so the default build/pack paths are unchanged. See
    docs/native-aot.md; verify with `bash scripts/verify-aot.sh`.
  -->
</Project>
