<Project>
  <!--
    Shared build conventions for the Pi .NET port.
    Mirrors the TS monorepo layout: src/<Pi.Package> maps to packages/<pkg>.
  -->

  <!--
    Native AOT source-generated JSON contexts live in each package and emit
    metadata for DTO types declared in sibling packages. Some of those DTOs use
    internal JsonConverter implementations, so the context's compilation must be
    able to see the siblings' internals. This is a compile-time friend grant
    only: it adds no public API and changes no runtime behaviour.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pi.Agent" />
    <InternalsVisibleTo Include="Pi.Ai" />
    <InternalsVisibleTo Include="Pi.Chord" />
    <InternalsVisibleTo Include="Pi.Cli" />
    <InternalsVisibleTo Include="Pi.Client" />
    <InternalsVisibleTo Include="Pi.Codemode" />
    <InternalsVisibleTo Include="Pi.CodingAgent" />
    <InternalsVisibleTo Include="Pi.Durable" />
    <InternalsVisibleTo Include="Pi.DurableHost" />
    <InternalsVisibleTo Include="Pi.Env" />
    <InternalsVisibleTo Include="Pi.Evals" />
    <InternalsVisibleTo Include="Pi.Mcp" />
    <InternalsVisibleTo Include="Pi.Protocol" />
    <InternalsVisibleTo Include="Pi.Server" />
    <InternalsVisibleTo Include="Pi.Telemetry" />
    <InternalsVisibleTo Include="Pi.Tui" />
    <InternalsVisibleTo Include="Pi.Vacation" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Native AOT publishing (opt-in: `scripts/publish-aot.sh`, or
    `dotnet publish src/Pi.Cli -c Release -f net10.0 -r <rid> -p:PublishAot=true`).

    The default multi-target build (net9.0;net10.0;net11.0) is untouched: this
    group is only evaluated when PublishAot is explicitly requested.

      * TargetFrameworks -> net10.0: Native AOT emits one native image for one
        TFM + RID. net11.0 also needs an 11.x SDK that may not be installed.
      * JsonSerializerIsReflectionEnabledByDefault=true: keep the ~250
        JsonSerializer reflection overloads working for primitive / JsonNode
        values and as a fallback. The POCO paths that Native AOT cannot handle
        are routed through the source-generated contexts in each package's
        Aot/AotJson.cs (installed only when RuntimeFeature.IsDynamicCodeSupported
        is false, so JIT behaviour is unchanged).
      * IlcGenerateCompleteTypeMetadata=true + full assembly rooting: preserve
        reflection metadata and code for every Pi assembly so no capability is
        trimmed away — this is the "lossless" part of the AOT support.
      * The IL2xxx/IL3xxx advisories are expected here: they describe the
        trimming / runtime-code-generation hazards that the source-generated
        metadata and complete-metadata mode explicitly cover. Every suppressed
        category is exercised by scripts/verify-aot.py against the real native
        binary; see docs/native-aot.md.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <TargetFrameworks>net10.0</TargetFrameworks>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <IlcGenerateCompleteTypeMetadata>true</IlcGenerateCompleteTypeMetadata>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2026;IL2072;IL2075;IL2090;IL2111;IL3000;IL3050</NoWarn>
  </PropertyGroup>

  <!--
    NuGet packaging metadata shared by every package.
    Version is the single source of truth: the release workflow overrides it
    with -p:Version=<tag version>, and local `dotnet pack` uses it as-is.
  -->
  <PropertyGroup>
    <Version>1.5.2.1</Version>
    <Authors>xuzeyu</Authors>
    <Product>Pi.NET</Product>
    <Description>Pi.NET - a .NET 9/10/11 port of Pi, a minimal and extensible agent harness. See https://github.com/AIDotNet/pi.net for the full package list.</Description>
    <Copyright>Copyright (c) 2025 Mario Zechner (upstream Pi); .NET port Copyright (c) 2026 xuzeyu</Copyright>
    <PackageProjectUrl>https://github.com/AIDotNet/pi.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AIDotNet/pi.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>pi;ai;llm;agent;mcp;tui;dotnet;csharp</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Ship the repo root license + readme inside every package. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    SourceLink: lets consumers step into Pi sources from a .snupkg.
    必须是 10.0.111 / 10.0.303 / 10.0.4xx 这类已修复版本：8.0.0 与 10.0.1xx/2xx/3xx 早期版本
    通过 Microsoft.Build.Tasks.Git 命中 CVE-2026-62900（GHSA-23fw-v26w-5fgq），
    而本仓库 TreatWarningsAsErrors 会把 NU1902 升级成 error，导致 restore 直接失败。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
  </ItemGroup>
</Project>
