<Project>
  <!--
    Shared build conventions for the Pi .NET port.
    Mirrors the TS monorepo layout: src/<Pi.Package> maps to packages/<pkg>.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    NuGet packaging metadata shared by every package.
    Version is the single source of truth: the release workflow overrides it
    with -p:Version=<tag version>, and local `dotnet pack` uses it as-is.
  -->
  <PropertyGroup>
    <Version>1.0.4</Version>
    <Authors>xuzeyu91</Authors>
    <Product>Pi.NET</Product>
    <Description>Pi.NET - a .NET 10 port of Pi, a minimal and extensible agent harness. See https://github.com/xuzeyu91/pi.net for the full package list.</Description>
    <Copyright>Copyright (c) 2025 Mario Zechner (upstream Pi); .NET port Copyright (c) 2026 xuzeyu91</Copyright>
    <PackageProjectUrl>https://github.com/xuzeyu91/pi.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xuzeyu91/pi.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>pi;ai;llm;agent;mcp;tui;dotnet;csharp</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Ship the repo root license + readme inside every package. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- SourceLink: lets consumers step into Pi sources from a .snupkg. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
