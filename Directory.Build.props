<Project>
  <!--
    Shared build conventions for the Pi .NET port.
    Mirrors the TS monorepo layout: src/<Pi.Package> maps to packages/<pkg>.
  -->
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    NuGet packaging metadata shared by every package.
    Version is the single source of truth: the release workflow overrides it
    with -p:Version=<tag version>, and local `dotnet pack` uses it as-is.
  -->
  <PropertyGroup>
    <Version>1.4.5</Version>
    <Authors>xuzeyu</Authors>
    <Product>Pi.NET</Product>
    <Description>Pi.NET - a .NET 9/10 port of Pi, a minimal and extensible agent harness. See https://github.com/AIDotNet/pi.net for the full package list.</Description>
    <Copyright>Copyright (c) 2025 Mario Zechner (upstream Pi); .NET port Copyright (c) 2026 xuzeyu</Copyright>
    <PackageProjectUrl>https://github.com/AIDotNet/pi.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AIDotNet/pi.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>pi;ai;llm;agent;mcp;tui;dotnet;csharp</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Ship the repo root license + readme inside every package. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    SourceLink: lets consumers step into Pi sources from a .snupkg.
    必须是 10.0.111 / 10.0.303 / 10.0.4xx 这类已修复版本：8.0.0 与 10.0.1xx/2xx/3xx 早期版本
    通过 Microsoft.Build.Tasks.Git 命中 CVE-2026-62900（GHSA-23fw-v26w-5fgq），
    而本仓库 TreatWarningsAsErrors 会把 NU1902 升级成 error，导致 restore 直接失败。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
  </ItemGroup>
</Project>
