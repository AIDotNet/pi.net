<Project>
  <!--
    Shared build conventions for the Pi .NET port.
    Mirrors the TS monorepo layout: src/<Pi.Package> maps to packages/<pkg>.
  -->

  <!--
    Native AOT source-generated JSON contexts live in each package and emit
    metadata for DTO types declared in sibling packages. Some of those DTOs use
    internal JsonConverter implementations, so the context's compilation must be
    able to see the siblings' internals. This is a compile-time friend grant
    only: it adds no public API and changes no runtime behaviour.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pi.Agent" />
    <InternalsVisibleTo Include="Pi.Ai" />
    <InternalsVisibleTo Include="Pi.Chord" />
    <InternalsVisibleTo Include="Pi.Cli" />
    <InternalsVisibleTo Include="Pi.Client" />
    <InternalsVisibleTo Include="Pi.Codemode" />
    <InternalsVisibleTo Include="Pi.CodingAgent" />
    <InternalsVisibleTo Include="Pi.Durable" />
    <InternalsVisibleTo Include="Pi.DurableHost" />
    <InternalsVisibleTo Include="Pi.Env" />
    <InternalsVisibleTo Include="Pi.Evals" />
    <InternalsVisibleTo Include="Pi.Mcp" />
    <InternalsVisibleTo Include="Pi.Protocol" />
    <InternalsVisibleTo Include="Pi.Server" />
    <InternalsVisibleTo Include="Pi.Telemetry" />
    <InternalsVisibleTo Include="Pi.Tui" />
    <InternalsVisibleTo Include="Pi.Vacation" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    .NET 8 compatibility (net8.0 only; the other three TFMs are untouched).

    The port uses BCL APIs that first appeared in .NET 9. For net8.0 we supply
    two things instead of ~70 `#if` branches scattered through the sources:

      * System.Text.Json 9.0.10 from NuGet. The package's net8.0 asset carries
        the .NET 9 API surface (JsonStringEnumMemberNameAttribute, and
        JsonSerializerOptions.NewLine / IndentCharacter / IndentSize) and is the
        assembly actually loaded at runtime, so indented JSON and enum wire
        names stay byte-identical to the net9.0+ builds. It also keeps the
        source-generated JSON contexts working.
      * build/Net8Polyfills.cs, compiled into every net8.0 project, providing
        internal shims for System.Threading.Lock and System.Buffers.Text.Base64Url
        (plus build/Net8OrderedDictionary.cs, see below). The other three .NET 9
        APIs are handled at their call sites: Convert.ToHexStringLower(x) becomes
        Convert.ToHexString(x).ToLowerInvariant(), Enumerable.Index() becomes
        Select((item, index) => (index, item)), and Task.WhenEach is an #if NET8_0
        WhenAny loop in Pi.Agent/ToolExecution.cs.

    Both are gated on TargetFramework so net9.0/net10.0/net11.0 restore, build
    and pack exactly as before. The generated extension projects in Pi.Evals
    derive their TFM from Environment.Version and therefore emit net8.0 too.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="9.0.10" />
    <Compile Include="$(MSBuildThisFileDirectory)build/Net8Polyfills.cs" Link="Net8Polyfills.cs" />
  </ItemGroup>

  <!--
    OrderedDictionary<TKey,TValue> (.NET 9) backs the public
    BuildSystemPromptOptions.Sections property, so its shim must be public. It is
    compiled into exactly one assembly (Pi.CodingAgent) to avoid CS0433 ambiguity
    in every friend assembly; other Pi projects and the test projects resolve it
    through their Pi.CodingAgent reference.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' and '$(MSBuildProjectName)' == 'Pi.CodingAgent'">
    <Compile Include="$(MSBuildThisFileDirectory)build/Net8OrderedDictionary.cs" Link="Net8OrderedDictionary.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!--
      CS0436 is expected here: build/Net8Polyfills.cs defines Lock/Base64Url in
      every assembly, and the repo's blanket InternalsVisibleTo makes those
      internal types visible to sibling Pi assemblies, so the compiler reports a
      "conflicts with imported type" warning at every use. It is benign: the
      compiler resolves to the source-defined copy (identical implementation),
      which is exactly the private per-assembly type we want. The other three
      TFMs do not compile this file and keep TreatWarningsAsErrors unsilenced.
    -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!--
    Native AOT publishing (opt-in: `scripts/publish-aot.sh`, or
    `dotnet publish src/Pi.Cli -c Release -f net10.0 -r <rid> -p:PublishAot=true`).

    The default multi-target build (net8.0;net9.0;net10.0;net11.0) is untouched: this
    group is only evaluated when PublishAot is explicitly requested.

      * TargetFrameworks -> net10.0: Native AOT emits one native image for one
        TFM + RID. net11.0 also needs an 11.x SDK that may not be installed.
      * JsonSerializerIsReflectionEnabledByDefault=true: keep the ~250
        JsonSerializer reflection overloads working for primitive / JsonNode
        values and as a fallback. The POCO paths that Native AOT cannot handle
        are routed through the source-generated contexts in each package's
        Aot/AotJson.cs (installed only when RuntimeFeature.IsDynamicCodeSupported
        is false, so JIT behaviour is unchanged).
      * IlcGenerateCompleteTypeMetadata=true + full assembly rooting: preserve
        reflection metadata and code for every Pi assembly so no capability is
        trimmed away — this is the "lossless" part of the AOT support.
      * The IL2xxx/IL3xxx advisories are expected here: they describe the
        trimming / runtime-code-generation hazards that the source-generated
        metadata and complete-metadata mode explicitly cover. Every suppressed
        category is exercised by scripts/verify-aot.py against the real native
        binary; see docs/native-aot.md.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!--
      AOT 只产出一个 TFM + RID 的原生映像，默认 net10.0（脚本硬编码的历史行为）。
      scripts/publish-aot.sh 的第 4 个参数会传 -p:AotFramework=<tfm> 以选择目标
      （net8.0 亦受支持）；直接 dotnet publish 时也可显式传 -p:AotFramework=net8.0。
    -->
    <AotFramework Condition="'$(AotFramework)' == ''">net10.0</AotFramework>
    <TargetFrameworks>$(AotFramework)</TargetFrameworks>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!--
      ILCompiler 随 runtime pack 的补丁版本走。SDK 自带的补丁版（10.0.12）有
      NuGet 审计告警 GHSA-p3jp-9v83-76w9（NU1903 会被 TreatWarningsAsErrors 升级成
      错误，AOT 发布直接失败）。ILCompiler 只是构建期工具，不进入产物；与其压告警，
      不如取最新的运行时补丁：TargetLatestRuntimePatch 会还原已修补的 runtime pack
      与配套 ILCompiler，产物仍是自包含原生映像，运行时不依赖该补丁。
    -->
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <IlcGenerateCompleteTypeMetadata>true</IlcGenerateCompleteTypeMetadata>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2026;IL2072;IL2075;IL2090;IL2111;IL3000;IL3050</NoWarn>
  </PropertyGroup>

  <!--
    NuGet packaging metadata shared by every package.
    Version is the single source of truth: the release workflow overrides it
    with -p:Version=<tag version>, and local `dotnet pack` uses it as-is.
  -->
  <PropertyGroup>
    <Version>1.7.0</Version>
    <Authors>xuzeyu</Authors>
    <Product>Pi.NET</Product>
    <Description>Pi.NET - a .NET 8/9/10/11 port of Pi, a minimal and extensible agent harness. See https://github.com/AIDotNet/pi.net for the full package list.</Description>
    <Copyright>Copyright (c) 2025 Mario Zechner (upstream Pi); .NET port Copyright (c) 2026 xuzeyu</Copyright>
    <PackageProjectUrl>https://github.com/AIDotNet/pi.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AIDotNet/pi.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>pi;ai;llm;agent;mcp;tui;dotnet;csharp</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Ship the repo root license + readme inside every package. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    SourceLink: lets consumers step into Pi sources from a .snupkg.
    必须是 10.0.111 / 10.0.303 / 10.0.4xx 这类已修复版本：8.0.0 与 10.0.1xx/2xx/3xx 早期版本
    通过 Microsoft.Build.Tasks.Git 命中 CVE-2026-62900（GHSA-23fw-v26w-5fgq），
    而本仓库 TreatWarningsAsErrors 会把 NU1902 升级成 error，导致 restore 直接失败。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
  </ItemGroup>
</Project>
