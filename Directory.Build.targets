<Project>
  <!--
    Executables (Pi.Cli, Pi.Vacation, Pi.DurableHost, Pi.Evals) and the test hosts are
    not shipped as NuGet packages - only the 13 src/ libraries are.

    This lives in Directory.Build.targets rather than Directory.Build.props because
    OutputType is only known after each project file has been evaluated;
    Directory.Build.props is imported before that.
  -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Native AOT: root every Pi assembly from the executable being published.
    Combined with IlcGenerateCompleteTypeMetadata (Directory.Build.props) this
    keeps all code and reflection metadata, so the AOT binary retains every
    capability of the JIT build rather than trimming reflection-only paths.
  -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">
    <TrimmerRootAssembly Include="Pi.Agent" />
    <TrimmerRootAssembly Include="Pi.Ai" />
    <TrimmerRootAssembly Include="Pi.Chord" />
    <TrimmerRootAssembly Include="Pi.Client" />
    <TrimmerRootAssembly Include="Pi.Codemode" />
    <TrimmerRootAssembly Include="Pi.CodingAgent" />
    <TrimmerRootAssembly Include="Pi.Durable" />
    <TrimmerRootAssembly Include="Pi.Mcp" />
    <TrimmerRootAssembly Include="Pi.Protocol" />
    <TrimmerRootAssembly Include="Pi.Server" />
    <TrimmerRootAssembly Include="Pi.Telemetry" />
    <TrimmerRootAssembly Include="Pi.Tui" />
  </ItemGroup>

  <!--
    版本一致性守卫。

    `Config.Version` 的取值顺序是：程序集版本打底；如果 `Assets/package.json` 就躺在程序集旁边，
    再用它的 `version` 覆盖。这个文件**不随 NuGet 包分发**（包里没有它，消费方读到的是程序集版本），
    它只在本仓库内充当「版本号第二处」。而发版流程（.github/workflows/nuget-publish.yml）
    只改 Directory.Build.props 的 <Version>。1.4.0 发布时就是漏改资产，导致启动横幅和
    命令行的版本输出仍报 v1.0.4。这里在构建期把这种漂移直接变成错误，别等发出去才发现。
  -->
  <Target Name="ValidatePackagedVersion"
          BeforeTargets="BeforeBuild"
          Condition="'$(MSBuildProjectName)' == 'Pi.CodingAgent'
                     and '$(DesignTimeBuild)' != 'true'
                     and Exists('$(MSBuildProjectDirectory)/Assets/package.json')">
    <PropertyGroup>
      <_PiPackageJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Assets/package.json'))</_PiPackageJson>
      <_PiPackagedVersion>$([System.Text.RegularExpressions.Regex]::Match($(_PiPackageJson), '(?&lt;="version": ")[^"]+').Value)</_PiPackagedVersion>
    </PropertyGroup>
    <Error Condition="'$(_PiPackagedVersion)' != '$(Version)'"
           Text="Assets/package.json 的 version（$(_PiPackagedVersion)）与 Directory.Build.props 的 &lt;Version&gt;（$(Version)）不一致。启动横幅与 --version 取前者，发版时两处必须同时改。" />
  </Target>
</Project>
