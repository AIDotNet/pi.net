<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!-- This project ships its own TestEntryPoint.cs (which also declares SelfRegisteredExtensions).
         The Microsoft.Testing.Platform.MSBuild targets would otherwise generate an identical
         obj/.../SelfRegisteredExtensions.cs and add it to the compilation, producing CS0101. -->
    <GenerateSelfRegisteredExtensions>false</GenerateSelfRegisteredExtensions>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Differential test vectors captured from the TypeScript utils reference implementations. -->
    <None Include="utils-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Second slice: node path semantics, semver, version checks, clipboard routing, config/self-update. -->
    <None Include="core-utils-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Third slice: git source parsing (git.ts + hosted-git-info) and the changelog helpers. -->
    <None Include="git-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fourth slice: the managed-tool downloader, the Windows self-update quarantine, and
         node:path.toNamespacedPath. -->
    <None Include="tools-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="zip-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="syntax-highlight-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="frontmatter-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fifth slice: minimatch@10.2.6 (glob matching), which the model resolver's case-insensitive
         model-id globs depend on. -->
    <None Include="minimatch-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sixth slice: core/model-resolver.ts, captured by importing the real source (the generator only
         rewrites its import header; see tools/gen-coding-agent-model-resolver-corpus.mjs). -->
    <None Include="model-resolver-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4d-6: extensions/tool-search/tool.ts (BM25 ranker, tokenizer, tool_search tool definition). -->
    <None Include="tool-search-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4d-7a: extensions/llama/{client,huggingface}.ts (llama.cpp server client, Hugging Face API). -->
    <None Include="llama-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4e-1: the core modules with no session dependency — prompt templates, slash commands, auth
         guidance, the telemetry/experimental gates, the missing-cwd guard, provider attribution, the
         crash log, and decodeURI. -->
    <None Include="prompt-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4e-2b: core/messages.ts — the four coding-agent message roles, the summary constants,
         bashExecutionToText, the three factories, convertToLlm, and the AgentMessage JSON wire shape. -->
    <None Include="messages-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4e-2c-1: core/session-manager.ts types and pure tree/projection logic — session version,
         assertValidSessionId, parseSessionEntries, migrateSessionEntries (v1→v2→v3),
         getLatestCompactionEntry, sessionEntryToContextMessages, buildContextEntries,
         buildSessionProjection/Context, getDefaultSessionDir. -->
    <None Include="session-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4d-5: extensions/codemode/tool.ts (schema, declarations, description catalog, loadout),
         core/usage-totals.ts, and readCodemodeStore from execute.ts. -->
    <None Include="codemode-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4e-2c-2: session-manager.ts file I/O and directory discovery (loadEntriesFromFile,
         findMostRecentSession, buildSessionInfo/listSessionsFromDir through the list facade). -->
    <None Include="session-files-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4e-2c-3: session-manager.ts SessionManager class (file switching, append*, tree traversal,
         branching, createBranchedSession, static factories). -->
    <None Include="session-manager-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4e-2d: core/compaction/* (utils, compaction, branch-summarization), core/skills.ts
         formatSkillsForPrompt and core/system-prompt.ts. -->
    <None Include="compaction-corpus.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pi.CodingAgent\Pi.CodingAgent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\Pi.CodingAgent\Assets\export-html\**\*">
      <Link>Assets\export-html\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
